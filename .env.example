# Copy to .env to override defaults (docker compose and the backend read it). Never commit .env.

# Backend
APP_ENV=dev
DATABASE_URL=postgresql+asyncpg://health:health@localhost:5433/health_tracker

# Tests (scripts/test.*): integration tests create this database if it does not exist
TEST_DATABASE_URL=postgresql+asyncpg://health:health@localhost:5433/health_tracker_test

# docker compose
POSTGRES_USER=health
POSTGRES_PASSWORD=health
POSTGRES_DB=health_tracker
POSTGRES_HOST_PORT=5433
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
