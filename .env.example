# Copy to .env to override defaults (docker compose and the backend read it). Never commit .env.

# Backend
APP_ENV=dev
DATABASE_URL=postgresql+asyncpg://health:health@localhost:5433/health_tracker

# Demo user, created on api start (python -m app.seed). Empty password: no demo user.
# A changed password takes effect on the next api start. scripts/smoke.* read these from the shell.
DEMO_USER_EMAIL=demo@example.com
DEMO_USER_PASSWORD=demo12345
DEMO_USER_TIMEZONE=Europe/Moscow

# Tests: read from the shell environment (not from .env); set it if you change POSTGRES_HOST_PORT.
# The integration test fixture creates this database if it does not exist.
TEST_DATABASE_URL=postgresql+asyncpg://health:health@localhost:5433/health_tracker_test

# docker compose
POSTGRES_USER=health
POSTGRES_PASSWORD=health
POSTGRES_DB=health_tracker
POSTGRES_HOST_PORT=5433
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
API_PORT=8000
FRONTEND_PORT=5173
